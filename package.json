{
  "name": "satscout",
  "version": "0.1.0",
  "description": "Deterministic local foundation for a bounded-authority purchasing agent",
  "license": "MIT",
  "type": "module",
  "private": false,
  "bin": {
    "satscout": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.0.0 <12"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "browser:install": "playwright install chromium",
    "build": "tsc -p tsconfig.build.json",
    "cli": "tsx src/cli/index.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "playwright": "^1.62.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
