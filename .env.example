# Both switches default to false when omitted. Only the exact strings true and
# false are accepted; malformed values stop startup rather than enabling a feature.
# Live booking is necessary but not sufficient for cart capture: the explicit
# capture command also requires --confirm-live-cart.
# Live spend is necessary but not sufficient for a Wavelength Signet Send.
SATSCOUT_LIVE_BOOKING=false
SATSCOUT_LIVE_SPEND=false
SATSCOUT_ALLOW_MAINNET_SPEND=false
SATSCOUT_ALLOW_SIMULATED_SPEND=false
SATSCOUT_ALLOW_SIGNET_TEST_SPEND=false

# Local SQLite file used by the CLI.
SATSCOUT_DB_PATH=./data/satscout.sqlite

# Dedicated Recreation.gov Chromium profile. This directory contains sensitive
# authenticated browser state. Keep it private and never commit or share it.
SATSCOUT_BROWSER_PROFILE_DIR=./.local/browser/recreation-gov

# Headed mode is the default for visible, deliberate observation. Only exact
# lowercase true and false are accepted.
SATSCOUT_BROWSER_HEADLESS=false

# Bounded Playwright navigation and page-observation timeout.
SATSCOUT_BROWSER_TIMEOUT_MS=30000

# Wavelength Signet daemon. Loopback REST only. Do not commit the macaroon.
# SATSCOUT_WAVELENGTH_REST_URL=http://127.0.0.1:10031
# SATSCOUT_WAVELENGTH_MACAROON_PATH=/absolute/path/to/admin.macaroon
# Mainnet ceilings may only be tightened from these hard MVP defaults.
# SATSCOUT_WAVELENGTH_MAINNET_MAX_WALLET_BALANCE_SAT=100000
# SATSCOUT_WAVELENGTH_MAINNET_MAX_PRINCIPAL_SAT=25000
# SATSCOUT_WAVELENGTH_MAINNET_MAX_FEE_SAT=2000
# SATSCOUT_WAVELENGTH_MAINNET_MAX_TOTAL_OUTFLOW_SAT=27000
# SATSCOUT_WAVELENGTH_HTTP_TIMEOUT_MS=30000
# SATSCOUT_WAVELENGTH_INTENT_MIN_TTL_MS=15000
